image boot.vfat {
	vfat {
		label = "WirelessAA"
		files = {
			"aawgd.conf",
#BOOT_FILES#
		}
	}

	size = 32M
}

image persist.ext4 {
	name = "persist"
	ext4 {
		label = "persist"
		use-mke2fs = true
	}
	# Holds bluetooth/seedrng state plus the persistent log (/persist/aawgd.log).
	# 512M gives the log generous room; the extra space is empty ext4 so it
	# compresses to almost nothing in the .img.xz, only the flash writes more.
	size = 512M
}


image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition persist {
		partition-type = 0x83
		image = "persist.ext4"
	}
}
