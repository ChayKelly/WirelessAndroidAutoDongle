# Add f_accessory function for usb gadget
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_ACC=y

# Disable bnep in bluetooth
CONFIG_BT_BNEP=n

# Thermal, clock and supply-voltage telemetry, for /usr/bin/aawgd-heartbeat.
# The heartbeat reads these every tick and a silently missing one shows up as a
# dash rather than as an error, so pin them here instead of taking them on
# trust. bcm2709_defconfig already sets six of the seven, which is fine: they
# are cheap redundant safeguards against a defconfig change upstream.
#
# SENSORS_RASPBERRYPI_HWMON is the load-bearing one. The defconfig is believed
# to have it as =m, so this line is what makes it built-in and removes any
# dependence on module autoload winning a race against S94aawgd_heartbeat.
# Verify after building, because merge_config.sh only WARNS when a fragment
# line does not survive, so a dropped line still produces a build that looks
# perfectly successful and then reads "-" for the whole drive:
#
#   grep -E '^CONFIG_(THERMAL|THERMAL_OF|BCM2835_THERMAL|HWMON|SENSORS_RASPBERRYPI_HWMON|CPU_FREQ|CPU_FREQ_STAT|ARM_RASPBERRYPI_CPUFREQ)=y$' \
#     buildroot/output/rpi02w/build/linux-*/.config
#
# Expect eight lines. THERMAL_OF appears there but is deliberately NOT set
# below: it has no prompt and can only be select'ed (BCM2835_THERMAL does it),
# so a fragment line for it is silently dropped and would only look like a
# guarantee it cannot give.
#
# BCM2835_THERMAL       -> /sys/class/thermal/thermal_zone0/temp (SoC temp)
# SENSORS_RASPBERRYPI_HWMON -> the rpi_volt hwmon device, whose in0_lcrit_alarm
#                          is the firmware's under-voltage flag. This also gives
#                          the kernel its "Under-voltage detected!" and "Voltage
#                          normalised" messages, which klogd already captures
#                          into /persist/aawgd.log. Those messages come off the
#                          driver's own ~2s poll, so they are a finer record of
#                          a sag than uvolt= sampled every 8-45s: grep them
#                          first and treat uvolt=/uvoltseen= as corroboration.
# ARM_RASPBERRYPI_CPUFREQ -> cpuinfo_cur_freq / scaling_cur_freq (ARM clock)
# CPU_FREQ_STAT         -> cumulative time at each frequency, so a whole boot's
#                          worth of throttling can be read even if the ticks
#                          sampled either side of it.
CONFIG_THERMAL=y
CONFIG_BCM2835_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_RASPBERRYPI_HWMON=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y

# Disable some kernel debugging options
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_DEBUG_FS=n
CONFIG_KGDB=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_FTRACE=n
CONFIG_SLUB_DEBUG=n
