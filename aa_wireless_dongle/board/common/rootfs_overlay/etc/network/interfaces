auto wlan0
iface wlan0 inet static
  address 10.0.0.1
  netmask 255.255.255.0
  # Log to /persist (not /var/log, which is RAM) so association/deauth events
  # survive ignition-off. Fall back to /var/log if /persist did not mount, so a
  # missing partition can never stop hostapd starting (that would kill the AP).
  pre-up sh -c 'l=/persist/hostapd.log; grep -q " /persist " /proc/mounts || l=/var/log/hostapd; hostapd -B /var/run/hostapd.conf -t -f "$l"'
  # Wifi power save causes latency spikes and dropouts on the shared Broadcom radio
  post-up iw dev wlan0 set power_save off || true
  #post-up dnsmasq
  #pre-down killall -q dnsmasq
  post-down killall -q hostapd

