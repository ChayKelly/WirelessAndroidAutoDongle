#!/bin/sh
#
# Periodic heartbeat + wifi telemetry, written to the persistent syslog.
#
# This runs OUTSIDE aawgd on purpose. If aawgd wedges on a silently dead link it
# stops emitting its own logs, so "the log just stopped" is ambiguous: wedge, or
# power loss? An independent heartbeat resolves that. While it keeps ticking the
# system is alive, so a gap in aawgd/teardown lines with heartbeats still flowing
# is a wedge; heartbeats stopping too is power loss (or a full-system hang).
#
# It also samples the AP-side link rates and byte counters, and calls sync() at
# a bounded rate so the last lines before the car cuts power have a good chance
# of reaching disk.
#
# Every field is best-effort: a missing tool or value logs "-" and never breaks
# the loop.

# Pick up AAWG_PROXY_PORT / an optional AAWG_HEARTBEAT_INTERVAL if configured.
[ -r /etc/aawgd.conf ] && . /etc/aawgd.conf 2>/dev/null

INTERVAL="${AAWG_HEARTBEAT_INTERVAL:-45}"
# A nonnumeric or zero interval would make sleep fail and spin the loop into a
# tight logger+sync storm. Force it to a positive integer, else fall back to 45s.
case "$INTERVAL" in
	''|*[!0-9]*) INTERVAL=45 ;;
esac
[ "$INTERVAL" -ge 1 ] 2>/dev/null || INTERVAL=45

# sync is decoupled from the tick rate. Diagnostic drives run the interval down
# to 10s to make a track change visible (songs run three to four minutes, so 45s
# cannot resolve one), and syncing every tick at that rate would be 4.5x the SD
# card writes for no extra safety. Bounding it by elapsed time instead keeps the
# worst-case log-tail loss where it has always been, about 45 seconds.
SYNC_INTERVAL=45

WLAN=wlan0
PORT="${AAWG_PROXY_PORT:-5288}"

dash() {
	# Print $1, or "-" if it is empty.
	if [ -n "$1" ]; then printf '%s' "$1"; else printf '-'; fi
}

# Log the raw station dump once per boot, the first time a phone is associated,
# as the standing record of what brcmfmac actually reports in AP mode. It is
# what settled the empty signal=/txretries= question after two road tests: the
# driver emits neither line, so no amount of parser fallback was ever going to
# revive them.
dumped=0

# Log the AP's channel and the regulatory domain in force, once per boot. Two
# drives recorded neither, so channel 1 and GB have been taken on trust. Done
# inside the loop rather than before it because wlan0 may not be up yet when
# this script starts; it retries until there is something to report.
configdumped=0

# Uptime in whole seconds at the last sync, so the rate limit above has a clock
# that does not depend on the tick actually taking $INTERVAL.
last_sync=""

while true; do
	uptime_s=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)

	if pidof aawgd >/dev/null 2>&1; then aawgd=up; else aawgd=DOWN; fi

	# Free space on the log partition, so we can see it filling if it ever does.
	persist_free=$(df -k /persist 2>/dev/null | awk 'NR==2 {print $4"k"}')

	if [ "$configdumped" = 0 ]; then
		wlaninfo=$(iw dev "$WLAN" info 2>/dev/null)
		# Gate on the interface info, not on "iw reg get", which answers even
		# with no interface up and would otherwise burn the one-shot early.
		if [ -n "$wlaninfo" ]; then
			configdumped=1
			reginfo=$(iw reg get 2>/dev/null)
			printf '%s\n' "$wlaninfo" "$reginfo" | while IFS= read -r line; do
				if [ -n "$line" ]; then
					logger -t heartbeat-config "$line"
				fi
			done

			# Channel survey, probed once per boot instead of sampled every
			# tick. brcmfmac does not implement survey dump in AP mode, so
			# noise/chactive/chbusy/chrx/chtx were "-" on every heartbeat of
			# drives 3, 4 and 5, one of them at an 8s interval. That is five
			# dead fields on every line for nothing, so they came out of the
			# heartbeat exactly as signal= and txretries= did before them.
			#
			# What is left is this capability probe. Silence is the finding, so
			# it is logged explicitly rather than logged as nothing: one line a
			# boot says the driver still cannot do it. If a kernel or firmware
			# update ever implements it the numbers appear here, and the
			# per-tick fields are worth restoring at that point. It is not a
			# measurement, so do not read the counters in it as one.
			survey=$(iw dev "$WLAN" survey dump 2>/dev/null)
			if [ -n "$survey" ]; then
				printf '%s\n' "$survey" | while IFS= read -r line; do
					if [ -n "$line" ]; then
						logger -t heartbeat-survey "$line"
					fi
				done
			else
				logger -t heartbeat-survey "no output: survey dump not implemented by this driver in AP mode"
			fi
		fi
	fi

	# Phone association + AP-side link quality. Empty station dump = no phone.
	assoc=no
	txrate=""; rxrate=""; txfailed=""
	rxbytes=""; txbytes=""; rxpkts=""; txpkts=""
	dump=$(iw dev "$WLAN" station dump 2>/dev/null)
	if [ -n "$dump" ]; then
		assoc=yes
		txrate=$(printf '%s\n' "$dump"    | awk '/tx bitrate:/ {print $3; exit}')
		rxrate=$(printf '%s\n' "$dump"    | awk '/rx bitrate:/ {print $3; exit}')
		txfailed=$(printf '%s\n' "$dump"  | awk '/tx failed:/  {print $3; exit}')
		# Cumulative counters. txrate/rxrate are the rate of a single recent
		# frame, so a low reading may just be rate control probing rather than a
		# degraded link; differencing these across two ticks gives the throughput
		# actually achieved in between, which is the figure worth trusting.
		rxbytes=$(printf '%s\n' "$dump"   | awk '/rx bytes:/   {print $3; exit}')
		txbytes=$(printf '%s\n' "$dump"   | awk '/tx bytes:/   {print $3; exit}')
		rxpkts=$(printf '%s\n' "$dump"    | awk '/rx packets:/ {print $3; exit}')
		txpkts=$(printf '%s\n' "$dump"    | awk '/tx packets:/ {print $3; exit}')

		if [ "$dumped" = 0 ]; then
			dumped=1
			printf '%s\n' "$dump" | while IFS= read -r line; do
				logger -t heartbeat-dump "$line"
			done
		fi
	fi

	# Established proxy connections: a strong "actively forwarding" signal.
	# Best-effort, needs netstat; falls back to "-" if absent.
	conns=""
	if command -v netstat >/dev/null 2>&1; then
		conns=$(netstat -tn 2>/dev/null | grep -c ":$PORT .*ESTABLISHED")
	fi

	logger -t heartbeat "up=${uptime_s}s aawgd=$(dash "$aawgd") assoc=$(dash "$assoc") txrate=$(dash "$txrate")M rxrate=$(dash "$rxrate")M txfailed=$(dash "$txfailed") rxbytes=$(dash "$rxbytes") txbytes=$(dash "$txbytes") rxpkts=$(dash "$rxpkts") txpkts=$(dash "$txpkts") conns=$(dash "$conns") persistfree=$(dash "$persist_free")"

	# Flush so the tail survives an abrupt power cut at ignition-off, but no
	# more often than SYNC_INTERVAL of elapsed time. If /proc/uptime gave us
	# nothing there is no clock to rate limit against, so fall back to syncing
	# every tick, which is what this did before.
	uptime_i="${uptime_s%%.*}"
	case "$uptime_i" in
		''|*[!0-9]*) uptime_i='' ;;
	esac
	if [ -z "$uptime_i" ] || [ -z "$last_sync" ] || [ $((uptime_i - last_sync)) -ge "$SYNC_INTERVAL" ]; then
		sync
		last_sync="$uptime_i"
	fi

	sleep "$INTERVAL"
done
