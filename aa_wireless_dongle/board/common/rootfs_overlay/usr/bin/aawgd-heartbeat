#!/bin/sh
#
# Periodic heartbeat + wifi telemetry, written to the persistent syslog.
#
# This runs OUTSIDE aawgd on purpose. If aawgd wedges on a silently dead link it
# stops emitting its own logs, so "the log just stopped" is ambiguous: wedge, or
# power loss? An independent heartbeat resolves that. While it keeps ticking the
# system is alive, so a gap in aawgd/teardown lines with heartbeats still flowing
# is a wedge; heartbeats stopping too is power loss (or a full-system hang).
#
# It also samples the AP-side link rates and byte counters, the SoC temperature,
# the ARM clock and the firmware's throttle/under-voltage flags, and calls sync()
# at a bounded rate so the last lines before the car cuts power have a good
# chance of reaching disk.
#
# Every field is best-effort: a missing tool or value logs "-" and never breaks
# the loop.

# Pick up AAWG_PROXY_PORT / an optional AAWG_HEARTBEAT_INTERVAL if configured.
[ -r /etc/aawgd.conf ] && . /etc/aawgd.conf 2>/dev/null

INTERVAL="${AAWG_HEARTBEAT_INTERVAL:-45}"
# A nonnumeric or zero interval would make sleep fail and spin the loop into a
# tight logger+sync storm. Force it to a positive integer, else fall back to 45s.
case "$INTERVAL" in
	''|*[!0-9]*) INTERVAL=45 ;;
esac
[ "$INTERVAL" -ge 1 ] 2>/dev/null || INTERVAL=45

# sync is decoupled from the tick rate. Diagnostic drives run the interval down
# to 10s to make a track change visible (songs run three to four minutes, so 45s
# cannot resolve one), and syncing every tick at that rate would be 4.5x the SD
# card writes for no extra safety. Bounding it by elapsed time instead keeps the
# worst-case log-tail loss where it has always been, about 45 seconds.
SYNC_INTERVAL=45

WLAN=wlan0
PORT="${AAWG_PROXY_PORT:-5288}"

dash() {
	# Print $1, or "-" if it is empty.
	if [ -n "$1" ]; then printf '%s' "$1"; else printf '-'; fi
}

# Log the raw station dump once per boot, the first time a phone is associated,
# as the standing record of what brcmfmac actually reports in AP mode. It is
# what settled the empty signal=/txretries= question after two road tests: the
# driver emits neither line, so no amount of parser fallback was ever going to
# revive them.
dumped=0

# Log the AP's channel and the regulatory domain in force, once per boot. Two
# drives recorded neither, so channel 1 and GB have been taken on trust. Done
# inside the loop rather than before it because wlan0 may not be up yet when
# this script starts; it retries until there is something to report.
configdumped=0

# Uptime in whole seconds at the last sync, so the rate limit above has a clock
# that does not depend on the tick actually taking $INTERVAL.
last_sync=""

######## Thermal and power telemetry ########
#
# Added 25 Jul 2026 after Chay recalled a hot afternoon where the dongle
# rebooted repeatedly for the first ten or fifteen minutes and then held once
# the aircon had cooled the cabin. Drives 1-5 cannot answer that: the only
# thermal line in any of those captures is the boot-time governor registration,
# there is no RTC so nothing can be pinned to a time of day, and neither
# temperature nor supply voltage was ever sampled. These fields exist so the
# next hot drive is answerable instead of a hypothesis.
#
# What each field can and cannot settle:
#
# - temp=/tempmax=  SoC temperature. Throttling starts at 80C and the ceiling
#   is 85C, and neither is a reboot: it slows down, it does not fall over. So a
#   high temp does not by itself explain a power cut. Two caveats worth keeping
#   in mind before reading too much into it. This is die temperature, not cabin
#   temperature: it moves with load, enclosure airflow and how recently the
#   board rebooted, so it is a noisy proxy for the ambient heat the hypothesis
#   is actually about. And "does not by itself explain" is not "cannot
#   contribute". What it is good for is correlation: if reboots cluster while
#   temp is high and stop as it falls, heat is implicated in whatever is
#   marginal, most plausibly the connector or the regulator's brownout margin.
# - freq=  ARM clock in MHz. On its own it proves nothing, because the governor
#   idles the core at 600MHz perfectly happily; a low clock is only interesting
#   sitting next to a high temp or a set cap bit.
# - uvolt=/uvoltseen=  the firmware's under-voltage alarm via raspberrypi-hwmon,
#   live and sticky-since-boot. Best onboard corroboration of a power-integrity
#   problem, which is not the same as identifying the connector: all it says is
#   that the local 5V rail crossed the alarm threshold. It cannot separate the
#   connector from the cable, the head unit's supply or the Pi's own regulator.
#   READ THE ABSENCE CAREFULLY: this is sampled state, not a latch, so a sag
#   shorter than the tick interval is missed entirely, and a fast open-circuit
#   reset can be over before anything is polled or flushed. `uvolt=0` all drive
#   is therefore NOT evidence that power is fine. `uvoltseen=1` is strong
#   positive evidence; `uvoltseen=0` is weak negative evidence. The kernel also
#   prints "Under-voltage detected!" / "Voltage normalised" of its own accord,
#   and klogd already puts those in the same file, which is the better record
#   of the two because it does not depend on this loop's timing.
# - throttled=  the firmware's throttle bitmask, if this kernel exposes it. The
#   sticky half (bits 16-19) is the valuable part: it records that under-voltage
#   or a frequency cap HAS happened since boot, so a spike between two ticks is
#   still caught at 45s intervals.
#
# Paths are resolved once per boot rather than every tick, and what was and was
# not found is logged explicitly as `heartbeat-power`, following the same
# convention as `heartbeat-survey`: silence is a finding, so record it as one
# line a boot rather than as five dashes on every line forever.
THERMAL_PATH=""
FREQ_PATH=""
UVOLT_PATH=""
THROTTLED_PATH=""
powerprobed=0

# Highest temperature seen this boot, in millidegrees. The peak matters more
# than any single sample: at a 45s tick a hot soak is easy to sample either side
# of, and this survives to the last line before power is cut.
temp_max=""

# Last-logged states, so the edge-triggered warnings below fire on a change
# rather than on every tick.
last_band=""
last_uvolt=""
last_throttled=""
last_usb=""

# The USB gadget's sysfs directory, resolved once. aawgd finds the same UDC by
# taking the last entry in /sys/class/udc; there is exactly one on this hardware
# (3f980000.usb), so any entry is the right one. Empty means the gadget driver
# did not probe, which is worth seeing rather than silently skipping.
UDC_DIR=""
for u in /sys/class/udc/*; do
	[ -d "$u" ] || continue
	UDC_DIR="$u"
done

# Sticky: has the under-voltage alarm asserted at any point this boot. Starts
# at 0 rather than empty so `uvoltseen=0` reads as "sampled, never asserted"
# instead of as a missing field.
uvolt_seen=0

resolve_power_paths() {
	# SoC temperature. thermal_zone0 is the CPU zone on every Pi, but walk the
	# zones anyway rather than assume the numbering.
	for z in /sys/class/thermal/thermal_zone*/temp; do
		[ -r "$z" ] || continue
		THERMAL_PATH="$z"
		break
	done

	# ARM clock. scaling_cur_freq is what the governor last asked for;
	# cpuinfo_cur_freq is what the hardware reports and is the better of the
	# two, so prefer it when the driver provides it.
	for f in /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_cur_freq \
	         /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq; do
		[ -r "$f" ] || continue
		FREQ_PATH="$f"
		break
	done

	# Under-voltage alarm, exposed by raspberrypi-hwmon as the "rpi_volt"
	# device. Match on the name rather than a fixed hwmon number, which depends
	# on probe order and is not stable across kernels.
	for h in /sys/class/hwmon/hwmon*; do
		[ -r "$h/name" ] || continue
		case "$(cat "$h/name" 2>/dev/null)" in
			rpi_volt)
				[ -r "$h/in0_lcrit_alarm" ] && UVOLT_PATH="$h/in0_lcrit_alarm"
				break
				;;
		esac
	done

	# Firmware throttle bitmask. Downstream Pi kernels have exposed this at a
	# couple of paths over the years and dropped it again in places, so try both
	# and treat its absence as normal rather than as a fault.
	for t in /sys/devices/platform/soc/soc:firmware/get_throttled \
	         /sys/devices/platform/soc/*.firmware/get_throttled; do
		[ -r "$t" ] || continue
		THROTTLED_PATH="$t"
		break
	done

	# One source per line. All four on one line came to 273 characters, which is
	# exactly where BusyBox syslogd cuts, so the throttled= path lost its last
	# character and read as get_throttle rather than get_throttled: a path that
	# does not exist, in the one line whose whole job is to say what was found.
	logger -t heartbeat-power "source temp=$(dash "$THERMAL_PATH")"
	logger -t heartbeat-power "source freq=$(dash "$FREQ_PATH")"
	logger -t heartbeat-power "source uvolt=$(dash "$UVOLT_PATH")"
	logger -t heartbeat-power "source throttled=$(dash "$THROTTLED_PATH")"

	# The trip points say where this board's firmware starts throttling, so a
	# reader does not have to take 80C/85C on trust from a datasheet.
	if [ -n "$THERMAL_PATH" ]; then
		zdir=$(dirname "$THERMAL_PATH")
		trips=""
		for tp in "$zdir"/trip_point_*_temp; do
			[ -r "$tp" ] || continue
			tptype="${tp%_temp}_type"
			trips="$trips $(basename "$tp"):$(cat "$tp" 2>/dev/null)m:$(cat "$tptype" 2>/dev/null)"
		done
		logger -t heartbeat-power "thermal zone $(cat "$zdir/type" 2>/dev/null) trips:$(dash "$trips")"
	fi

	if [ -n "$FREQ_PATH" ]; then
		fdir=$(dirname "$FREQ_PATH")
		logger -t heartbeat-power "cpufreq driver=$(cat "$fdir/scaling_driver" 2>/dev/null) gov=$(cat "$fdir/scaling_governor" 2>/dev/null) min=$(cat "$fdir/scaling_min_freq" 2>/dev/null)kHz max=$(cat "$fdir/scaling_max_freq" 2>/dev/null)kHz"
	fi

	# Say so plainly when a source is missing, because a run of "-" in the
	# per-tick line otherwise reads as "cool and fine" when it means "not
	# measured". The kernel options that supply these are set in
	# board/common/kernel.config.
	[ -z "$THERMAL_PATH" ] && logger -t heartbeat-power "no thermal zone: CONFIG_BCM2835_THERMAL missing, temp= will be - all drive"
	[ -z "$FREQ_PATH" ]    && logger -t heartbeat-power "no cpufreq: CONFIG_ARM_RASPBERRYPI_CPUFREQ missing, freq= will be - all drive"
	[ -z "$UVOLT_PATH" ]   && logger -t heartbeat-power "no rpi_volt hwmon: CONFIG_SENSORS_RASPBERRYPI_HWMON missing, uvolt= will be - all drive"
	[ -z "$THROTTLED_PATH" ] && logger -t heartbeat-power "no get_throttled sysfs on this kernel; rely on uvolt= and the kernel's own under-voltage messages"

	# Same contract as the lines above: say what was found, and say plainly when
	# nothing was, so an absence of usb-state lines during a drive cannot be read
	# as "the USB link never changed".
	#
	# The interval is reported here too. It has now been left at the 45s default on
	# three diagnostic drives in a row while the notes assumed 8s, and reading a
	# capture at the wrong assumed resolution is worse than reading it at a known
	# coarse one. This puts the answer in the first few lines of every boot.
	logger -t heartbeat-usb "interval=${INTERVAL}s syncinterval=${SYNC_INTERVAL}s"
	if [ -n "$UDC_DIR" ]; then
		logger -t heartbeat-usb "source udc=$UDC_DIR state=$(dash "$(cat "$UDC_DIR/state" 2>/dev/null)") speed=$(dash "$(cat "$UDC_DIR/current_speed" 2>/dev/null)")"
	else
		logger -t heartbeat-usb "no udc under /sys/class/udc: gadget driver did not probe, usb-state lines will be absent all drive"
	fi
}

# Strip leading zeroes from a digit string, so it cannot be read as octal.
#
# The `*[!0-9]*` guards below accept "08" and "09", which are digit-only but
# invalid octal literals, and BusyBox ash parses arithmetic operands base-0.
# `$((08 / 1000))` is therefore a FATAL arith error, not a warning: it kills
# this unsupervised script and the rest of the drive's telemetry with it. The
# kernel formats every value read here with %d/%u so a leading zero should
# never actually arrive, but the whole file is written on the premise that
# garbage input must not kill the loop, and this is the one class of garbage
# that still could. Not `$((10#$1))`, which is a bashism and would itself
# break under ash.
strip_leading_zeroes() {
	stripped="${1#"${1%%[!0]*}"}"
	if [ -n "$stripped" ]; then printf '%s' "$stripped"; else printf '0'; fi
}

millidegrees_to_c() {
	# 53215 -> 53.2. Integer arithmetic only, this is BusyBox ash.
	case "$1" in
		''|*[!0-9]*) printf '-'; return ;;
	esac
	m=$(strip_leading_zeroes "$1")
	printf '%s.%s' "$((m / 1000))" "$(((m % 1000) / 100))"
}

# Which side of the interesting thresholds the SoC is on. Named rather than
# numeric so the log line reads without a lookup table.
#
# 80C is where this SoC's firmware starts throttling and 85C is its ceiling,
# where throttling gets more aggressive. The bands are deliberately NOT called
# "soft limit": the firmware has its own distinct `temp_soft_limit` setting
# which is a different number, so that name would collide with an existing
# term and mislead whoever greps this log in six months.
temp_band() {
	case "$1" in
		''|*[!0-9]*) printf 'unknown'; return ;;
	esac
	if   [ "$1" -ge 85000 ]; then printf 'TEMP-CEILING'
	elif [ "$1" -ge 80000 ]; then printf 'THROTTLING'
	elif [ "$1" -ge 70000 ]; then printf 'hot'
	else printf 'ok'
	fi
}

while true; do
	uptime_s=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)

	if pidof aawgd >/dev/null 2>&1; then aawgd=up; else aawgd=DOWN; fi

	# Free space on the log partition, so we can see it filling if it ever does.
	persist_free=$(df -k /persist 2>/dev/null | awk 'NR==2 {print $4"k"}')

	# Thermal and power sampling. Resolved on the first tick rather than before
	# the loop, so a driver that probes late is still picked up.
	if [ "$powerprobed" = 0 ]; then
		powerprobed=1
		resolve_power_paths
	fi

	temp_m=""; temp_c=""; temp_max_c=""; freq_mhz=""; uvolt=""; throttled=""
	if [ -n "$THERMAL_PATH" ]; then
		temp_m=$(cat "$THERMAL_PATH" 2>/dev/null)
		case "$temp_m" in
			''|*[!0-9]*) temp_m="" ;;
		esac
	fi
	if [ -n "$temp_m" ]; then
		temp_c=$(millidegrees_to_c "$temp_m")
		if [ -z "$temp_max" ] || [ "$temp_m" -gt "$temp_max" ]; then
			temp_max="$temp_m"
		fi
	fi
	# Converted outside the block above, and gated on the retained peak rather
	# than on this tick's reading. Inside it, a single failed read would log
	# `tempmax=-` while a perfectly good peak was still held in memory, which
	# is exactly backwards for a high-water mark whose job is to survive the
	# samples around it.
	[ -n "$temp_max" ] && temp_max_c=$(millidegrees_to_c "$temp_max")

	if [ -n "$FREQ_PATH" ]; then
		freq_khz=$(cat "$FREQ_PATH" 2>/dev/null)
		case "$freq_khz" in
			''|*[!0-9]*) freq_khz="" ;;
		esac
		[ -n "$freq_khz" ] && freq_mhz=$(( $(strip_leading_zeroes "$freq_khz") / 1000 ))
	fi

	[ -n "$UVOLT_PATH" ] && uvolt=$(cat "$UVOLT_PATH" 2>/dev/null)
	[ -n "$THROTTLED_PATH" ] && throttled=$(cat "$THROTTLED_PATH" 2>/dev/null)

	# Sticky "has ever asserted this boot" flag for the under-voltage alarm.
	#
	# The alarm as read is an instantaneous state, so a sag shorter than the
	# gap between two ticks is invisible: at a 45s interval that is most of a
	# brownout. Temperature already carries a high-water mark for the same
	# reason and voltage is the field that matters more here, so it gets one
	# too. This is the local stand-in for the firmware's sticky throttle bits,
	# which may not exist on this kernel at all.
	if [ "$uvolt" = "1" ]; then uvolt_seen=1; fi

	# Edge-triggered warnings, so a threshold crossing is one greppable line
	# rather than something to be spotted by eye in a wall of ticks. Logged on
	# the way down as well as up: "it cooled and then behaved" is exactly the
	# pattern this whole block was added to test.
	band=$(temp_band "$temp_m")
	if [ "$band" != "unknown" ] && [ "$band" != "$last_band" ]; then
		[ -n "$last_band" ] && logger -t heartbeat-power "temp band $last_band -> $band at ${temp_c}C (up=${uptime_s}s)"
		last_band="$band"
	fi
	if [ -n "$uvolt" ] && [ "$uvolt" != "$last_uvolt" ]; then
		if [ "$uvolt" = "1" ]; then
			logger -t heartbeat-power "UNDER-VOLTAGE alarm asserted at up=${uptime_s}s temp=$(dash "$temp_c")C: the 5V rail crossed the alarm threshold, read this alongside the USB teardowns"
		else
			[ -n "$last_uvolt" ] && logger -t heartbeat-power "under-voltage alarm cleared at up=${uptime_s}s"
		fi
		last_uvolt="$uvolt"
	fi
	if [ -n "$throttled" ] && [ "$throttled" != "$last_throttled" ]; then
		logger -t heartbeat-power "throttle flags $(dash "$last_throttled") -> $throttled at up=${uptime_s}s (bit0 undervolt now, bit1 freq capped, bit2 throttled, bit3 soft temp limit; bits 16-19 same, sticky since boot)"
		last_throttled="$throttled"
	fi

	if [ "$configdumped" = 0 ]; then
		wlaninfo=$(iw dev "$WLAN" info 2>/dev/null)
		# Gate on the interface info, not on "iw reg get", which answers even
		# with no interface up and would otherwise burn the one-shot early.
		if [ -n "$wlaninfo" ]; then
			configdumped=1
			reginfo=$(iw reg get 2>/dev/null)
			printf '%s\n' "$wlaninfo" "$reginfo" | while IFS= read -r line; do
				if [ -n "$line" ]; then
					logger -t heartbeat-config "$line"
				fi
			done

			# Channel survey, probed once per boot instead of sampled every
			# tick. brcmfmac does not implement survey dump in AP mode, so
			# noise/chactive/chbusy/chrx/chtx were "-" on every heartbeat of
			# drives 3, 4 and 5, one of them at an 8s interval. That is five
			# dead fields on every line for nothing, so they came out of the
			# heartbeat exactly as signal= and txretries= did before them.
			#
			# What is left is this capability probe. Silence is the finding, so
			# it is logged explicitly rather than logged as nothing: one line a
			# boot says the driver still cannot do it. If a kernel or firmware
			# update ever implements it the numbers appear here, and the
			# per-tick fields are worth restoring at that point. It is not a
			# measurement, so do not read the counters in it as one.
			survey=$(iw dev "$WLAN" survey dump 2>/dev/null)
			if [ -n "$survey" ]; then
				printf '%s\n' "$survey" | while IFS= read -r line; do
					if [ -n "$line" ]; then
						logger -t heartbeat-survey "$line"
					fi
				done
			else
				logger -t heartbeat-survey "no output: survey dump not implemented by this driver in AP mode"
			fi
		fi
	fi

	# Phone association + AP-side link quality. Empty station dump = no phone.
	assoc=no
	txrate=""; rxrate=""; txfailed=""
	rxbytes=""; txbytes=""; rxpkts=""; txpkts=""
	dump=$(iw dev "$WLAN" station dump 2>/dev/null)
	if [ -n "$dump" ]; then
		assoc=yes
		txrate=$(printf '%s\n' "$dump"    | awk '/tx bitrate:/ {print $3; exit}')
		rxrate=$(printf '%s\n' "$dump"    | awk '/rx bitrate:/ {print $3; exit}')
		txfailed=$(printf '%s\n' "$dump"  | awk '/tx failed:/  {print $3; exit}')
		# Cumulative counters. txrate/rxrate are the rate of a single recent
		# frame, so a low reading may just be rate control probing rather than a
		# degraded link; differencing these across two ticks gives the throughput
		# actually achieved in between, which is the figure worth trusting.
		rxbytes=$(printf '%s\n' "$dump"   | awk '/rx bytes:/   {print $3; exit}')
		txbytes=$(printf '%s\n' "$dump"   | awk '/tx bytes:/   {print $3; exit}')
		rxpkts=$(printf '%s\n' "$dump"    | awk '/rx packets:/ {print $3; exit}')
		txpkts=$(printf '%s\n' "$dump"    | awk '/tx packets:/ {print $3; exit}')

		if [ "$dumped" = 0 ]; then
			dumped=1
			printf '%s\n' "$dump" | while IFS= read -r line; do
				logger -t heartbeat-dump "$line"
			done
		fi
	fi

	# Established proxy connections: a strong "actively forwarding" signal.
	# Best-effort, needs netstat; falls back to "-" if absent.
	conns=""
	if command -v netstat >/dev/null 2>&1; then
		conns=$(netstat -tn 2>/dev/null | grep -c ":$PORT .*ESTABLISHED")
	fi

	# Two lines, not one. BusyBox syslogd truncates a message at a fixed length
	# and the single combined line had grown into that cap: on Drive 6, 83 of 248
	# heartbeats came out at exactly 273 characters and 23 of them lost the
	# trailing throttled= field entirely. The byte and packet counters only get
	# longer as a drive goes on, so the tail field was going to keep being eaten.
	# Splitting keeps each line well clear of the limit and means a missing field
	# again reads as "not measured" rather than "ran off the end of the buffer".
	logger -t heartbeat "up=${uptime_s}s aawgd=$(dash "$aawgd") assoc=$(dash "$assoc") txrate=$(dash "$txrate")M rxrate=$(dash "$rxrate")M txfailed=$(dash "$txfailed") rxbytes=$(dash "$rxbytes") txbytes=$(dash "$txbytes") rxpkts=$(dash "$rxpkts") txpkts=$(dash "$txpkts") conns=$(dash "$conns") persistfree=$(dash "$persist_free")"
	logger -t heartbeat-tp "up=${uptime_s}s temp=$(dash "$temp_c")C tempmax=$(dash "$temp_max_c")C freq=$(dash "$freq_mhz")M uvolt=$(dash "$uvolt") uvoltseen=$(dash "$uvolt_seen") throttled=$(dash "$throttled")"

	# Flush so the tail survives an abrupt power cut at ignition-off, but no
	# more often than SYNC_INTERVAL of elapsed time. If /proc/uptime gave us
	# nothing there is no clock to rate limit against, so fall back to syncing
	# every tick, which is what this did before.
	uptime_i="${uptime_s%%.*}"
	case "$uptime_i" in
		''|*[!0-9]*) uptime_i='' ;;
	esac
	if [ -z "$uptime_i" ] || [ -z "$last_sync" ] || [ $((uptime_i - last_sync)) -ge "$SYNC_INTERVAL" ]; then
		sync
		last_sync="$uptime_i"
	fi

	# Wait out the tick one second at a time, watching the USB gadget link on the
	# way. This is the poll that catches the symptom Chay actually reports: Android
	# Auto vanishing off the head unit and returning about ten seconds later, which
	# is the gadget being torn down and re-enumerated. At the 45s tick that whole
	# event fits between two samples and is invisible.
	#
	# Edge triggered, so a stable link costs one comparison a second and logs
	# nothing. Two values are worth having:
	#
	#   state         not-attached / attached / powered / default / addressed /
	#                 configured. "not-attached" means VBUS went away, which is the
	#                 power or ground contact. Anything else means VBUS held and the
	#                 data pair failed instead. That is the single distinction eight
	#                 drives of logs have never been able to make.
	#   current_speed high-speed is normal. Drive 8 recorded two falls back to
	#                 full-speed, which is the high-speed handshake failing outright,
	#                 and Android Auto cannot run over 12 Mbit/s.
	#
	# Note the resolution limit rather than rediscovering it: the worst storm in
	# Drive 8 re-enumerated every ~340ms, so a 1s poll shows the churn but cannot
	# count the attempts. The kernel's own "new device is <speed>" lines still do
	# that, and klogd already puts them in this file.
	#
	# Built-in `read` with a redirect rather than $(cat ...), deliberately. This
	# runs once a second for the whole drive, and a command substitution forks a
	# subshell while a redirect into `read` forks nothing, so the steady state of a
	# link that is not changing costs no processes at all. The `-r` file test guards
	# against a missing attribute becoming a redirect failure in a loop that nothing
	# supervises.
	waited=0
	while [ "$waited" -lt "$INTERVAL" ]; do
		sleep 1
		waited=$((waited + 1))

		[ -n "$UDC_DIR" ] || continue

		usb_state=""
		usb_speed=""
		# The `2>/dev/null` sits before the input redirect on purpose. The UDC
		# directory disappears if the gadget driver ever unbinds, so the file can go
		# away between the -r test and the redirect. `read` is a regular builtin, not
		# a POSIX special one, so a failed redirect fails the command and leaves the
		# shell running (verified under dash); the variable stays empty and the line
		# logs "-", which is the intended degraded reading. All that is left to
		# suppress is the error text, and redirections are applied left to right, so
		# stderr has to be pointed away first or the message still escapes.
		[ -r "$UDC_DIR/state" ] && read -r usb_state 2>/dev/null < "$UDC_DIR/state"
		[ -r "$UDC_DIR/current_speed" ] && read -r usb_speed 2>/dev/null < "$UDC_DIR/current_speed"
		[ -n "$usb_state" ] || usb_state="-"
		[ -n "$usb_speed" ] || usb_speed="-"
		usb_now="$usb_state/$usb_speed"

		if [ "$usb_now" != "$last_usb" ]; then
			# Uptime is re-read here rather than reused from the tick above, so the
			# transition carries its own timestamp instead of the tick's.
			logger -t usb-state "up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)s $(dash "$last_usb") -> $usb_now"
			last_usb="$usb_now"
		fi
	done
done
