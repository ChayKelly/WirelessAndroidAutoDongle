#!/bin/sh
#
# Supervise aawgd: restart it if it ever crashes or exits, so a daemon failure
# recovers in seconds instead of staying dead until the dongle loses power.
# On TERM/INT, stop the child and exit so init script stop is clean.
#

CHILD_PID=0

# aawgd logs through syslog, but an uncaught C++ exception is reported by the
# runtime on stderr ("terminate called after throwing an instance of ...") and
# that line is the only description of the fault. S93aawgd starts this script
# with start-stop-daemon -b, which daemonizes and points stdio at /dev/null, so
# without an explicit redirect the message is lost and a crash is only visible
# as a bare exit status.
#
# A file rather than "aawgd | logger": a pipeline would make $! and wait see
# logger instead of aawgd, losing the exit status that identifies the crash
# (134 = SIGABRT).
#
# Capturing stderr must never become a precondition for starting the daemon. The
# redirection on the launch line is evaluated by the shell before execve, so an
# unopenable target means aawgd is never started at all and this loop spins
# forever with nothing running: the precise failure this wrapper exists to
# prevent, made permanent. Testing whether /persist is *mounted* is not enough,
# because it can be mounted read-only, full, or the path can be a directory. So
# probe for a target we can actually append to, and fall back to /dev/null rather
# than risk the daemon. Losing the diagnostics is an acceptable outcome; losing
# aawgd is not.
pick_errlog() {
	for candidate in /persist/aawgd-stderr.log /var/log/aawgd-stderr; do
		if { : >> "$candidate"; } 2>/dev/null; then
			printf '%s' "$candidate"
			return
		fi
	done
	printf '/dev/null'
}

terminate() {
	if [ "$CHILD_PID" != 0 ]; then
		kill "$CHILD_PID" 2>/dev/null
		wait "$CHILD_PID" 2>/dev/null
	fi
	exit 0
}

trap terminate TERM INT

while true; do
	# Re-probed every restart, so a partition that fills or goes read-only mid-life
	# costs us the log rather than the daemon.
	ERRLOG=$(pick_errlog)

	if [ "$ERRLOG" != /dev/null ]; then
		# Between-launches truncation only. It cannot bound a live aawgd streaming
		# to stderr; it is here so a crash loop over many restarts cannot fill the
		# partition and take the main log down with it. Crash output is a few lines
		# per launch, so in practice this should never fire.
		size=0
		[ -f "$ERRLOG" ] && size=$(wc -c < "$ERRLOG" 2>/dev/null)
		case "$size" in
			''|*[!0-9]*) size=0 ;;
		esac
		if [ "$size" -gt 1048576 ]; then
			# Keep the tail rather than emptying the file: the newest crash is the
			# one being diagnosed, and it is what pushed us over the limit.
			if tail -c 262144 "$ERRLOG" > "$ERRLOG.tmp" 2>/dev/null; then
				mv "$ERRLOG.tmp" "$ERRLOG" 2>/dev/null || : > "$ERRLOG" 2>/dev/null
			else
				rm -f "$ERRLOG.tmp" 2>/dev/null
				: > "$ERRLOG" 2>/dev/null
			fi
		fi

		# No RTC, so stamp uptime to line this file up against the syslog timeline.
		echo "==== aawgd start, uptime $(cut -d' ' -f1 /proc/uptime 2>/dev/null)s ====" >> "$ERRLOG" 2>/dev/null
	fi

	/usr/bin/aawgd >> "$ERRLOG" 2>&1 &
	CHILD_PID=$!
	wait "$CHILD_PID"
	STATUS=$?
	echo "aawgd exited with status $STATUS, restarting in 3 seconds" | logger -t aawgd-supervise
	CHILD_PID=0
	sleep 3 &
	wait $!
done
